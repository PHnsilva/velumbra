{
  "name": "velumbra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-runtime.mjs && next dev --hostname 127.0.0.1 --port 4173",
    "build": "node scripts/prepare-runtime.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "check": "tsc --noEmit && node --check src/prologue.js && node --check src/scene.js",
    "test": "node --import tsx --experimental-vm-modules --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
